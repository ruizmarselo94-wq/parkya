# Copiar este archivo como .env y completar con los datos reales.
# El .env NUNCA se sube al repositorio.

# Endpoint DIRECTO (sin "-pooler"): el pooler rompe las transacciones
# con los prepared statements nativos de PDO
DB_HOST=tu-endpoint.sa-east-1.aws.neon.tech
DB_PORT=5432
DB_NAME=parkya
DB_USER=parkya_owner
DB_PASS=tu_password
# Neon exige SSL
DB_SSLMODE=require
